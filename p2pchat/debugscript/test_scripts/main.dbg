label main:
    set [firsterror] 1;
    goto get_input;
    label get_input:
        $ print reenter message;
        eq [firsterror] 0;
        cjmp print_reenter_message;
        label print_reenter_message:
            set stdout "Please reinput";
            sig flush;
            ret;

        eq [firsterror] 1;
        cjmp reentry;
        label reentry:
            set [firsterror] 0;
            ret;

        $ reset r;
        set p1 "a";
        set r 0;

        $ get val 1;
        sig input;
        set a stdin;
        sig mk_flt;
        set [val1] a;

        $ get val 2;
        sig input;
        set a stdin;
        sig mk_flt;
        set [val2] a;

        eq r -1;
        cjmp get_input;
        ret;

    $ one is greater than two;
    gt [val1] [val2];
    cjmp onegttwo;
    label onegttwo:
        set stdout "The first value is greater than the second";
        sig flush;
        ret;

    $ two is greater than one;
    lt [val1] [val2];
    cjmp twogtone;
    label twogtone:
        set stdout "The second value is greater than the first";
        sig flush;
        ret;


    $ they are both equal;
    eq [val1] [val2];
    cjmp botheq;
    label botheq:
        set stdout "Both values are equal!";
        sig flush;
        ret;

    $ safely exit;
    set a 0;
    sig exit;
